  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.thk-im</groupId>
  <artifactId>core</artifactId>
  <version>0.5.9</version>
  <packaging>aar</packaging>
  <name>THK IM core</name>
  <description>THK IM Android core binary SDK</description>
  <url>https://github.com/THK-IM/SDK-Release</url>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.2.10</version>
      <scope>compile</scope>
    </dependency>
